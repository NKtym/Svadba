generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Response {
  id               Int      @id @default(autoincrement())
  fullName         String
  attending        Boolean
  plusOne          Boolean  @default(false)
  plusOneName      String?
  allergies        String?
  drinkPreferences String?
  foodPreferences  String?
  createdAt        DateTime @default(now())
}

model Admin {
  id       Int    @id @default(autoincrement())
  login    String @unique
  password String
}
